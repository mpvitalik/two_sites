        "[class*=\"winning-zone\"]",
        "[class*=\"live-bets\"]",
        "[class*=\"ticker\"]",
        "[class*=\"banner-timer\"]",
        "[class*=\"jackpot\"]"
      ],
      "removeSelectors": [],
      "hoverSelector": "",
